          <li><a href="#">Test</a></li> 
          <li> <a href="#">Test</a></li> 
    </ul> 
  </div> 

      <div class="actions"> 
      <ul class="user"> 
        <%= link_to cart_path, class: "cart-navigation-link" do %>
        <i class="fa fa-shopping-basket"></i>Cart
          <span class="cart-count">
            <%= current_cart.total_quantity %>
          </span>
        <% end %>

        <%# <li><a href="#"><i class="fa fa-user"></i> My Account</a></li>  %>
        <% if customer_signed_in? %>
          <li>
            <%= link_to  customer_profile_path  do%>

            <i class="fa fa-user-circle"></i>
              <%=current_customer.username%>
                 <% end %>
          </li>

          <li>
            <%= button_to "Log Out",
                          destroy_customer_session_path,
                          method: :delete,
                          class: "logout-button" %>
          </li>
        <% else %>
          <li>
            <%= link_to new_customer_session_path do %>
              <i class="fa fa-sign-in"></i>
              Log In
            <% end %>
          </li>

          <li>
            <%= link_to new_customer_registration_path do %>
              <i class="fa fa-user-plus"></i>
              Sign Up
            <% end %>
          </li>
        <% end %>
      </ul> 
    </div> 
</nav>


<div class="orders-page">
  <h1>My Orders</h1>

  <% if @orders.any? %>
    <% @orders.each do |order| %>
      <article class="order-card">
        <h2>Order #<%= order.id %></h2>

        <p>
          Date:
          <%= order.created_at.strftime("%B %d, %Y") %>
        </p>

        <p>
          Status:
          <%= order.status.titleize %>
        </p>

        <p>
          Total:
          <%= number_to_currency(order.total_price) %>
        </p>

        <%= link_to "View Order", order_path(order) %>
      </article>
    <% end %>
  <% else %>
    <p>You have not placed any orders yet.</p>
  <% end %>
</div>