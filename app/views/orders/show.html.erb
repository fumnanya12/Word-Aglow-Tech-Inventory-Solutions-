<div class="order-page">
  <h1>Order Confirmation</h1>

  <div class="order-information">
    <p>
      <strong>Order number:</strong>
      <%= @order.id %>
    </p>

    <p>
      <strong>Status:</strong>
      <%= @order.status.titleize %>
    </p>

    <p>
      <strong>Order date:</strong>
      <%= @order.created_at.strftime("%B %d, %Y") %>
    </p>
  </div>

  <div class="order-items">
    <% @order.order_items.each do |order_item| %>
      <article class="order-item">
        <div>
          <h2><%= order_item.product.name %></h2>

          <p>
            Quantity:
            <%= order_item.quantity %>
          </p>

          <p>
            Unit price:
            <%= number_to_currency(order_item.unit_price) %>
          </p>

         
        </div>
      </article>
    <% end %>
  </div>

<div class="order-summary">
  <p>
    Subtotal:
    <%= number_to_currency(@order.subtotal) %>
  </p>
  <%province=@order.customer.province%>

<% gst = @order.subtotal.to_d * (province.gst_rate.to_d ) %>
<% pst = @order.subtotal.to_d * (province.pst_rate.to_d ) %>
<% hst = @order.subtotal.to_d * (province.hst_rate.to_d ) %>

  <% if province.gst_rate.to_d.positive? %>
    <p>
      GST:
      <%= number_to_currency(gst) %>
    </p>
  <% end %>

  <% if province.pst_rate.to_d.positive? %>
    <p>
      PST:
      <%= number_to_currency(pst) %>
    </p>
  <% end %>

  <% if province.hst_rate.to_d.positive? %>
    <p>
      HST:
      <%= number_to_currency(hst) %>
    </p>
  <% end %>

  <p>
    <strong>
      Total:
      <%= number_to_currency(@order.total) %>
    </strong>
  </p>
</div>

  <%= link_to "Back to orders",
        orders_path,
        class: "continue-shopping-button" %>
</div>