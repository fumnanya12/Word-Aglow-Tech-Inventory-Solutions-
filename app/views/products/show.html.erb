

<%= link_to "Back", :back, class: "back-link" %>

<div class="product-show">
  <div class="product-image">
    <% product_image = @product.product_images.first %>

      <% if product_image&.image&.attached? %>
      <%= image_tag product_image.image,
                  alt: product_image.alt_text.presence || @product.name,
                  width: 210,
                  height: 250 %>
      <% else %>
      <%= image_tag "placeholder.png",
                  alt: "No image available for #{@product.name}",
                  width: 100,
                  height: 200 %>
      <% end %>
  </div>
  <div class="product-info">
    <span class="product-category"><%= @product.category.name %></span>
    <h1><%= @product.name %></h1>
     <p><strong>Model:</strong> <%= @product.sku %></p>
    <div class="product-pricing">
      <p><strong>Purchase Price:</strong> $<%= @product.product_price %></p>
      <p><strong>Rental Price:</strong> $<%= @product.rental_price %></p>
    </div>

      <% if @product.avaliable && @product.stock_quanity.to_i > 0 %>
      <%= form_with url: cart_items_path,
                    method: :post,
                    class: "add-to-cart-form" do |form| %>

        <%= form.hidden_field :product_id, value: @product.id %>

        <div class="quantity-field">
          <%= form.label :quantity, "Quantity" %>

          <%= form.number_field :quantity,
                value: 1,
                min: 1,
                max: @product.stock_quanity,
                required: true %>
        </div>

        <%= form.submit "Add to Cart",
              class: "add-to-cart-button" %>
      <% end %>

      <p class="stock-message">
        <%= @product.stock_quanity %> available
      </p>
    <% else %>
      <p class="out-of-stock">Currently unavailable</p>
    <% end %>




    <div class="product-description">
        <h3>Description</h3>
        <p><%= @product.description %></p>
      </div>

  </div>

</div>
