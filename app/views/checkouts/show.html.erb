<div class="checkout-page">
  <h1>Checkout</h1>

  <section class="checkout-address">
    <h2>Billing Address</h2>

    <p>
      <%= current_customer.first_name %>
      <%= current_customer.last_name %>
    </p>

    <p><%= current_customer.address_line_one %></p>

    <% if current_customer.address_line_two.present? %>
      <p><%= current_customer.address_line_two %></p>
    <% end %>

    <p>
      <%= current_customer.city %>,
      <%= current_customer.province.name %>
      <%= current_customer.postal_code %>
    </p>

    <%= link_to "Edit Address", edit_customer_profile_path %>
  </section>

  <section class="checkout-items">
    <h2>Order Items</h2>

    <% @cart.cart_items.includes(:product).each do |cart_item| %>
      <div class="checkout-item">
        <span>
          <%= cart_item.product.name %>
          × <%= cart_item.quantity %>
        </span>

        <span>
          <%= number_to_currency(cart_item.subtotal) %>
        </span>
      </div>
    <% end %>
  </section>

  <section class="checkout-summary">
    <h2>Order Summary</h2>

    <div class="summary-row">
      <span>Subtotal</span>
      <span><%= number_to_currency(@subtotal) %></span>
    </div>


    <% if @gst_amount.positive? %>
      <div class="summary-row">
        <span>
          GST (<%= current_customer.province.gst_rate %>%)
        </span>

        <span><%= number_to_currency(@gst_amount) %></span>
      </div>
    <% end %>

    <% if @pst_amount.positive? %>
      <div class="summary-row">
        <span>
          PST (<%= current_customer.province.pst_rate %>%)
        </span>

        <span><%= number_to_currency(@pst_amount) %></span>
      </div>
    <% end %>

    <% if @hst_amount.positive? %>
      <div class="summary-row">
        <span>
          HST (<%= current_customer.province.hst_rate %>%)
        </span>

        <span><%= number_to_currency(@hst_amount) %></span>
      </div>
    <% end %>

    <div class="summary-row total-row">
      <strong>Total</strong>
      <strong><%= number_to_currency(@total) %></strong>
    </div>

    <%= button_to "Place Order",
          checkout_path,
          method: :post,
          class: "place-order-button" %>
  </section>
</div>
<%= link_to "Back", :back, class: "back-link" %>