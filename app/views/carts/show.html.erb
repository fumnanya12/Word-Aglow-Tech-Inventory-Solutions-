<%= link_to "Back", :back, class: "back-link" %>

<div class="cart-page">
  <h1>Your Cart</h1>

  <% if @cart_items.any? %>
    <div class="cart-items">
      <% @cart_items.each do |cart_item| %>
        <% product = cart_item.product %>
        <% product_image = product.product_images.first %>

        <article class="cart-item">
          <div class="cart-item-image">
            <% if product_image&.image&.attached? %>
              <%= image_tag product_image.image,
                    alt: product_image.alt_text.presence || product.name %>
            <% else %>
              <%= image_tag "placeholder.png",
                    alt: "No image available for #{product.name}" %>
            <% end %>
          </div>

          <div class="cart-item-details">
            <h2>
              <%= link_to product.name, product_path(product) %>
            </h2>

            <p>Model: <%= product.sku %></p>

            <p>
              Unit price:
              <%= number_to_currency(product.product_price) %>
            </p>

            <%= form_with url: cart_item_path(cart_item),
                          method: :patch,
                          class: "cart-quantity-form" do |form| %>

              <%= form.label :quantity, "Quantity" %>

              <%= form.number_field :quantity,
                    value: cart_item.quantity,
                    min: 1,
                    max: product.stock_quanity %>

              <%= form.submit "Update" %>
            <% end %>

            <p class="cart-item-subtotal">
              Subtotal:
              <%= number_to_currency(cart_item.subtotal) %>
            </p>

            <%= button_to "Remove",
                  cart_item_path(cart_item),
                  method: :delete,
                  class: "remove-cart-item-button" %>
          </div>
        </article>
      <% end %>
    </div>

    <div class="cart-summary">
      <p>
        Total items:
        <strong><%= @cart.total_quantity %></strong>
      </p>

      <p>
        Cart total:
        <strong><%= number_to_currency(@cart.total_price) %></strong>
      </p>

      <%= button_to "Proceed to Checkout",
            checkout_path,
            method: :get,
            class: "checkout-button" %>
    </div>
  <% else %>
    <div class="empty-cart">
      <p>Your cart is currently empty.</p>

      <%= link_to "Continue Shopping",
            products_path,
            class: "continue-shopping-button" %>
    </div>
  <% end %>
</div>