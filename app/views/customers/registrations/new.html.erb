<%= link_to "← Back", request.referer || root_path, class: "back-link" %>
<div class="login-page">
<div class="login-container">

<h1>Create Customer Account</h1>


<%= form_with model: resource,
              scope: resource_name,
              url: registration_path(resource_name) do |form| %>
  <%= render "customers/shared/error_messages", resource: resource %>
   <div class="field">
   <p> <%= form.label :username %></p>
    <p> <%= form.text_field :username, autofocus: true, autocomplete: "username" %></p>
  </div>
  <div class="field">
   <p> <%= form.label :first_name %></p>
    <p><%= form.text_field :first_name %></p>
  </div>

  <div class="field">
     <p> <%= form.label :last_name %></p>
    <p>  <%= form.text_field :last_name %></p>
  </div>


  <div class="field">
    <p><%= form.label :email %></p>
    <p><%= form.email_field :email, autofocus: true, autocomplete: "email" %></p>
  </div>

  <div class="field">
    <p><%= form.label :password %></p>
    <% if @minimum_password_length %>
      <p><em>(<%= @minimum_password_length %> characters minimum)</em></p>
    <% end %>
    <p><%= form.password_field :password, autocomplete: "new-password" %></p>
  </div>

  <div class="field">
    <p><%= form.label :password_confirmation %></p>
    <p><%= form.password_field :password_confirmation, autocomplete: "new-password" %></p>
  </div>

  <div class="actions">
    <%= form.submit "Sign up" %>
  </div>
<% end %>


    <div class="devise-links">
      <%= render "customers/shared/links" %>
    </div>
</div>
</div>