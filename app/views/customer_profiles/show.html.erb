      <div class="actions"> 
      <ul class="user"> 
        <li><a href="#"><i class="fa fa-shopping-basket"></i>Cart</a></li> 
        <%# <li><a href="#"><i class="fa fa-user"></i> My Account</a></li>  %>
        <% if customer_signed_in? %>
          <li>
             <%= link_to  customer_profile_path  do%>
            <i class="fa fa-user-circle"></i>
              <%=current_customer.username%>
                 <% end %>
          </li>

          <li>
            <%= button_to "Log Out",
                          destroy_customer_session_path,
                          method: :delete,
                          class: "logout-button" %>
          </li>
        <% else %>
          <li>
            <%= link_to new_customer_session_path do %>
              <i class="fa fa-sign-in"></i>
              Log In
            <% end %>
          </li>

          <li>
            <%= link_to new_customer_registration_path do %>
              <i class="fa fa-user-plus"></i>
              Sign Up
            <% end %>
          </li>
        <% end %>
      </ul> 
    </div> 
</nav>

<div class="customer-profile">
  <h1>My Account</h1>

  <div class="customer-details">
    <div class="customer-detail">
      <strong>Username:</strong>
      <span><%= @customer.username %></span>
    </div>

    <div class="customer-detail">
      <strong>Email:</strong>
      <span><%= @customer.email %></span>
    </div>

    <div class="customer-detail">
      <strong>First name:</strong>
      <span><%= @customer.first_name %></span>
    </div>

    <div class="customer-detail">
      <strong>Last name:</strong>
      <span><%= @customer.last_name %></span>
    </div>

    <div class="customer-detail">
      <strong>Address line one:</strong>
      <span><%= @customer.address_line_one %></span>
    </div>

    <% if @customer.address_line_two.present? %>
      <div class="customer-detail">
        <strong>Address line two:</strong>
        <span><%= @customer.address_line_two %></span>
      </div>
    <% end %>

    <div class="customer-detail">
      <strong>City:</strong>
      <span><%= @customer.city %></span>
    </div>

    <div class="customer-detail">
      <strong>Province:</strong>
      <span><%= @customer.province %></span>
    </div>

    <div class="customer-detail">
      <strong>Postal code:</strong>
      <span><%= @customer.postal_code %></span>
    </div>
  </div>

  <div class="customer-profile-actions">
    <%= link_to "Edit Personal Details",
                edit_customer_profile_path,
                class: "profile-button" %>

    <%= link_to "Change Password",
                edit_customer_registration_path,
                class: "profile-button password-button" %>
  </div>
</div>