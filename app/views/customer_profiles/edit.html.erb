<%= render "shared/breadcrumbs",
    breadcrumbs: [
      { name: current_customer.username }
    ]
%>
<div class="customer-profile-form">
  <h1>Edit Personal Details</h1>

  <%= form_with model: @customer,
                url: customer_profile_path,
                method: :patch do |f| %>

    <% if @customer.errors.any? %>
      <div class="form-errors">
        <h2>
          <%= pluralize(@customer.errors.count, "error") %>
          prevented your details from being updated:
        </h2>

        <ul>
          <% @customer.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="edit-field">
      <%= f.label :username %>
      <%= f.text_field :username, autocomplete: "username" %>
    </div>

    <div class="edit-field">
      <%= f.label :first_name %>
      <%= f.text_field :first_name, autocomplete: "given-name" %>
    </div>

    <div class="edit-field">
      <%= f.label :last_name %>
      <%= f.text_field :last_name, autocomplete: "family-name" %>
    </div>

    <div class="edit-field">
      <%= f.label :address_line_one %>
      <%= f.text_field :address_line_one,
                       autocomplete: "address-line1" %>
    </div>

    <div class="edit-field">
      <%= f.label :address_line_two %>
      <%= f.text_field :address_line_two,
                       autocomplete: "address-line2" %>
    </div>

    <div class="edit-field">
      <%= f.label :city %>
      <%= f.text_field :city, autocomplete: "address-level2" %>
    </div>

    <div class="edit-field">
    <%= f.label :province_id, "Province" %>

    <%= f.select :province_id,
        Province.order(:name).pluck(:name, :id),
        { prompt: "Select a province or territory" },
        { autocomplete: "address-level1" } %>
    </div>

    <div class="edit-field">
      <%= f.label :postal_code %>
      <%= f.text_field :postal_code,
                       autocomplete: "postal-code" %>
    </div>

    <div class="edit-actions">
      <%= f.submit "Save Details" %>

      <%= link_to "Cancel",
                  customer_profile_path,
                  class: "cancel-button" %>
    </div>

  <% end %>
      <%= link_to "Back", :back  %>

</div>
